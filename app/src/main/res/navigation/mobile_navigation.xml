<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_summary"
>

    <fragment
        android:id="@+id/navigation_summary"
        android:name="com.example.syllabuspro.ui.summary.SummaryFragment"
        android:label="@string/title_summary"
        tools:layout="@layout/fragment_summary"
    />

    <fragment
        android:id="@+id/navigation_calendar"
        android:name="com.example.syllabuspro.ui.calendar.CalendarFragment"
        android:label="@string/title_calendar"
        tools:layout="@layout/fragment_calendar"
    />

    <fragment
        android:id="@+id/navigation_courses"
        android:name="com.example.syllabuspro.ui.courses.CoursesFragment"
        android:label="@string/title_courses"
        tools:layout="@layout/fragment_courses"
    />

    <fragment
        android:id="@+id/navigation_tasks"
        android:name="com.example.syllabuspro.ui.tasks.TasksFragment"
        android:label="@string/title_tasks"
        tools:layout="@layout/fragment_tasks"
    />

    <fragment
        android:id="@+id/navigation_view_items"
        android:name="com.example.syllabuspro.ui.view_items.ItemsViewFragment"
        android:label="@string/title_view_items"
        tools:layout="@layout/fragment_syllabus_items_view"
    />

    <fragment
        android:id="@+id/navigation_add_items"
        android:name="com.example.syllabuspro.ui.add_items.AddItemsFragment"
        android:label="@string/title_add_items"
        tools:layout="@layout/fragment_syllabus_items_view"
    />

    <fragment
        android:id="@+id/navigation_waiting_api_response"
        android:name="com.example.syllabuspro.ui.waiting_api_response.WaitingApiResponseFragment"
        android:label="@string/title_waiting_api_response"
        tools:layout="@layout/fragment_waiting_api_response"
        />
</navigation>