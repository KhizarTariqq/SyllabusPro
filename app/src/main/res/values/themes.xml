<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SyllabusPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Neutral primary brand color -->
        <item name="colorPrimary">@color/gray_800</item>
        <item name="colorPrimaryVariant">@color/gray_900</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Neutral secondary brand color -->
        <item name="colorSecondary">@color/gray_200</item>
        <item name="colorSecondaryVariant">@color/gray_400</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Override button background and text color -->
        <item name="extendedFloatingActionButtonPrimaryStyle">@color/gray_200</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColor">@color/black</item>

        <!-- Customize your theme here. -->
    </style>
</resources>