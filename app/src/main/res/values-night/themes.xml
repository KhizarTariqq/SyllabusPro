<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application dark theme -->
    <style name="Theme.SyllabusPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Neutral primary brand color (dark gray background) -->
        <item name="colorPrimary">@color/gray_900</item>
        <item name="colorPrimaryVariant">@color/gray_950</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Neutral secondary brand color (accent gray tones for surfaces/buttons) -->
        <item name="colorSecondary">@color/gray_600</item>
        <item name="colorSecondaryVariant">@color/gray_500</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background and surface colors -->
        <item name="android:colorBackground">@color/gray_950</item>
        <item name="colorSurface">@color/gray_850</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>

        <!-- Button background and text colors -->
        <item name="extendedFloatingActionButtonPrimaryStyle">@color/gray_700</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColor">@color/white</item>

        <!-- Customize your theme here -->
    </style>
</resources>